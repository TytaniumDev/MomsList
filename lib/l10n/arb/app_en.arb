{
    "@@locale": "en",
    "appTitle": "Mom's List",
    "@appTitle": {
        "description": "Name of the app, shown in the task switcher and app bar"
    },
    "feedbackButtonTooltip": "Send feedback",
    "@feedbackButtonTooltip": {
        "description": "App bar button that opens the feedback form"
    },
    "feedbackFormTitle": "Feedback",
    "@feedbackFormTitle": {
        "description": "Title of the feedback form. Keep it short so it is not cut off at the largest text size"
    },
    "feedbackMessageLabel": "Message",
    "@feedbackMessageLabel": {
        "description": "Label above the feedback message box. Keep it short so it fits on one line at the largest text size"
    },
    "feedbackMessagePlaceholder": "What's wrong, or what would you like changed?",
    "@feedbackMessagePlaceholder": {
        "description": "Hint shown in the empty feedback message box"
    },
    "feedbackValidationError": "Please type a message first.",
    "@feedbackValidationError": {
        "description": "Shown when the feedback form is sent without a message"
    },
    "feedbackSubmitButtonLabel": "Send",
    "@feedbackSubmitButtonLabel": {
        "description": "Button that sends the feedback"
    },
    "feedbackCancelButtonLabel": "Cancel",
    "@feedbackCancelButtonLabel": {
        "description": "Button that closes the feedback form without sending"
    },
    "feedbackSuccessMessage": "Thank you! Your feedback was sent.",
    "@feedbackSuccessMessage": {
        "description": "Shown after feedback is sent"
    },
    "feedbackSubmitErrorMessage": "Your feedback couldn't be sent. Please try again.",
    "@feedbackSubmitErrorMessage": {
        "description": "Shown when sending feedback fails"
    },
    "feedbackRemoveScreenshotButtonLabel": "Remove screenshot",
    "@feedbackRemoveScreenshotButtonLabel": {
        "description": "Button that removes the screenshot attached to the feedback"
    },
    "loadingLabel": "Loading",
    "@loadingLabel": {
        "description": "Read by screen readers for the spinner shown while the app starts"
    },
    "signInTitle": "Welcome!",
    "@signInTitle": {
        "description": "Heading on the sign-in page"
    },
    "signInMessage": "Sign in with your Google account so your list is the same on your phone and your computer.",
    "@signInMessage": {
        "description": "Explains why Mom should sign in"
    },
    "signInWithGoogleButton": "Sign in with Google",
    "@signInWithGoogleButton": {
        "description": "Button that signs in with a Google account"
    },
    "signInErrorMessage": "Signing in didn't work. Please check your internet connection and try again.",
    "@signInErrorMessage": {
        "description": "Shown when signing in fails"
    },
    "signOutButtonTooltip": "Sign out",
    "@signOutButtonTooltip": {
        "description": "App bar button that signs out"
    },
    "signOutDialogTitle": "Sign out?",
    "@signOutDialogTitle": {
        "description": "Title of the dialog that confirms signing out"
    },
    "signOutDialogMessage": "Your list stays saved. You can sign back in any time.",
    "@signOutDialogMessage": {
        "description": "Body of the dialog that confirms signing out"
    },
    "signOutDialogCancelButton": "Cancel",
    "@signOutDialogCancelButton": {
        "description": "Closes the sign-out dialog without signing out"
    },
    "signOutDialogConfirmButton": "Sign out",
    "@signOutDialogConfirmButton": {
        "description": "Confirms signing out"
    },
    "addItemHint": "Add item",
    "@addItemHint": {
        "description": "Hint in the box at the top of a store list for typing a new item. Keep it short"
    },
    "addItemButtonTooltip": "Add",
    "@addItemButtonTooltip": {
        "description": "Button beside the add-item box"
    },
    "groceryListEmptyMessage": "Nothing to get. Type an item above.",
    "@groceryListEmptyMessage": {
        "description": "Shown at the top of a store list when every item is checked off"
    },
    "gotItHeading": "Got it ({count})",
    "@gotItHeading": {
        "description": "Heading above the checked-off items on a store list",
        "placeholders": {
            "count": {
                "type": "int"
            }
        }
    },
    "suggestionOnThisList": "already on list",
    "@suggestionOnThisList": {
        "description": "After a suggested item that is already unchecked on this list"
    },
    "suggestionBoughtBefore": "bought before",
    "@suggestionBoughtBefore": {
        "description": "After a suggested item that was checked off on this list before"
    },
    "suggestionFromStore": "from {store}",
    "@suggestionFromStore": {
        "description": "After a suggested item that was entered at another store",
        "placeholders": {
            "store": {
                "type": "String"
            }
        }
    },
    "deleteItemDialogTitle": "Delete {item}?",
    "@deleteItemDialogTitle": {
        "description": "Title of the dialog shown when holding down an item",
        "placeholders": {
            "item": {
                "type": "String"
            }
        }
    },
    "deleteItemDialogMessage": "It will be taken off this list and won't be suggested here again.",
    "@deleteItemDialogMessage": {
        "description": "Body of the delete item dialog"
    },
    "deleteItemDialogCancelButton": "Cancel",
    "@deleteItemDialogCancelButton": {
        "description": "Keeps the item"
    },
    "deleteItemDialogConfirmButton": "Delete",
    "@deleteItemDialogConfirmButton": {
        "description": "Deletes the item"
    },
    "switchStoreHint": "Switch store",
    "@switchStoreHint": {
        "description": "Screen reader hint on the store name in the app bar, which opens the store list"
    },
    "storePickerTitle": "Stores",
    "@storePickerTitle": {
        "description": "Title of the page listing every store"
    },
    "storeItemsToGet": "{count, plural, =0{Nothing to get} =1{1 to get} other{{count} to get}}",
    "@storeItemsToGet": {
        "description": "How many unchecked items a store has, under its name in the store list",
        "placeholders": {
            "count": {
                "type": "int"
            }
        }
    },
    "newStoreHint": "New store",
    "@newStoreHint": {
        "description": "Hint in the box for adding a store, such as Costco"
    },
    "addStoreButton": "Add",
    "@addStoreButton": {
        "description": "Button that adds the typed store"
    },
    "noStoresMessage": "Add a store to start a list, like Costco or Albertsons.",
    "@noStoresMessage": {
        "description": "Shown before any stores exist"
    },
    "groceryLoadErrorMessage": "Your lists couldn't be loaded. Please check your internet connection.",
    "@groceryLoadErrorMessage": {
        "description": "Shown when stores cannot be loaded"
    }
}
